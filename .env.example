# .env file for Trading System Secrets
# Copy this file to .env and fill in your actual values

# Fyers API Credentials
FYERS_CLIENT_ID=your_client_id_here
FYERS_SECRET_KEY=your_secret_key_here
FYERS_REDIRECT_URI=https://www.google.com
FYERS_RESPONSE_TYPE=code
FYERS_GRANT_TYPE=authorization_code
FYERS_STATE=sample_state
FYERS_ID=your_fyers_id_here
FYERS_PIN=your_pin_here
FYERS_TOTP_TOKEN=your_totp_token_here

# Trading Configuration
TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# Database Configuration (if needed)
DB_NAME=trading_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Trading Modes
TRADING_MODE=paper  # Options: paper, live
LOG_LEVEL=INFO
